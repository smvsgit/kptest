# =============================================================
# Karyalay Portal - NEW Coolify Resource / Fresh Installation
# Values below are the only normal user inputs. Do NOT commit secrets.
# Database and initial Super Admin passwords are generated by Coolify.
# =============================================================

APP_NAME="SMVS Storage"
APP_URL=https://karyalay-portal.divyajivan.com
TZ=Asia/Kolkata

# Optional: leave APP_KEY blank. The app securely generates it once and
# stores it in persistent app-storage without printing its value.
APP_KEY=

# Recommended for a recreated Coolify resource because Traefik's Docker IP may change.
# App has no published host HTTP port; public traffic reaches it only via Traefik.
TRUSTED_PROXIES=*

SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Fresh-install Super Admin. Email is the only required login identity you enter.
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PHONE=

# MariaDB non-secret settings.
DB_DATABASE=karyalay
DB_USERNAME=karyalay

# =============================================================
# AUTO-GENERATED BY COOLIFY FROM docker-compose.yml - DO NOT TYPE VALUES
# =============================================================
# SERVICE_PASSWORD_64_SUPERADMIN      -> initial Super Admin login password
# SERVICE_PASSWORD_64_DATABASE        -> MariaDB application-user password
# SERVICE_PASSWORD_64_DBROOT   -> MariaDB root password
#
# Coolify persists these generated values for the life of the resource.
# Reveal/copy SERVICE_PASSWORD_64_SUPERADMIN from Coolify Environment Variables
# after creation so you can perform the first login. Never paste it into Git.

# Search (v02.01)
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=
MEILISEARCH_INDEX=karyalay_media_files
